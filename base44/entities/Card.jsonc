{
  "name": "Card",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the card (e.g. player name or card title)"
    },
    "set_name": {
      "type": "string",
      "description": "The set or collection the card belongs to"
    },
    "sport": {
      "type": "string",
      "enum": [
        "baseball",
        "basketball",
        "football",
        "hockey",
        "soccer",
        "pokemon",
        "magic_the_gathering",
        "yugioh",
        "other"
      ],
      "description": "Sport or TCG type"
    },
    "year": {
      "type": "string",
      "description": "Year of the card"
    },
    "card_number": {
      "type": "string",
      "description": "Card number in the set"
    },
    "image_url": {
      "type": "string",
      "description": "Photo of the card"
    },
    "unique_code": {
      "type": "string",
      "description": "Unique code for QR generation"
    },
    "description": {
      "type": "string",
      "description": "Optional description or notes about the card"
    },
    "scan_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times this card's QR code has been scanned"
    },
    "share_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times this card's story has been shared"
    },
    "price_paid": {
      "type": "number",
      "description": "Purchase price paid for this card in dollars"
    },
    "estimated_value": {
      "type": "number",
      "description": "User-entered estimated value of this card in dollars"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "common",
        "uncommon",
        "rare",
        "ultra_rare",
        "legendary",
        "1_of_1"
      ],
      "description": "Rarity tier of the card"
    },
    "status": {
      "type": "string",
      "enum": [
        "owned",
        "sold",
        "traded"
      ],
      "default": "owned",
      "description": "Current ownership status of the card"
    },
    "sold_traded_date": {
      "type": "string",
      "description": "ISO date when the card was sold or traded"
    },
    "sold_traded_value": {
      "type": "number",
      "description": "Value at time of sale or trade"
    },
    "sold_traded_notes": {
      "type": "string",
      "description": "Notes about the sale or trade"
    }
  },
  "required": [
    "name",
    "unique_code"
  ]
}